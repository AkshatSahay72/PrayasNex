# Adaptive Learning Platform - Prototype Environment Template (.env.example)

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./adaptive_learning.db

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Service Configuration (Optional - prototype runs fully offline with mock/seeded fallback)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Adaptive Logic Thresholds
WEAK_THRESHOLD=0.50
STRONG_THRESHOLD=0.80
