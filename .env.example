# Adaptive Learning Platform - Prototype Environment Template (.env.example)

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./adaptive_learning.db

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Groq LLM Provider Configuration (Backend only - never exposed to frontend)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# Adaptive Logic Thresholds (Deterministic Backend Logic)
WEAK_THRESHOLD=0.50
STRONG_THRESHOLD=0.80
